# Adresse du backend.
# En développement, laisser vide : le code utilise http://localhost:3000
# En production, renseigner l'adresse Render, par exemple :
# VITE_API_URL=https://whats-next-api.onrender.com

VITE_API_URL=

# Adresse publique du frontend, autorisée par le CORS.
# Plusieurs adresses possibles, séparées par des virgules.
# Exemple : https://whats-next.vercel.app
FRONTEND_URL=